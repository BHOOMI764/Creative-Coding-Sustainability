# ============================================
# Creative Coding - Environment Variables Example
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# FRONTEND CONFIGURATION (Vite)
# ============================================

# API URL for production
VITE_API_URL=https://creative-coding-server.onrender.com

# Environment mode
VITE_NODE_ENV=production

# ============================================
# SERVER CONFIGURATION (Express)
# ============================================

# Node environment
NODE_ENV=production

# Server port
PORT=10000

# Database URL (SQLite)
DATABASE_URL=sqlite:database.db

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# JWT Secret Key (use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345

# JWT expiration time
JWT_EXPIRE=7d

# Session secret for express-session
SESSION_SECRET=your-session-secret-key-change-this

# ============================================
# CORS & FRONTEND CONFIGURATION
# ============================================

# Allowed frontend origin for CORS
CORS_ORIGIN=https://your-vercel-deployment.vercel.app

# ============================================
# EMAIL CONFIGURATION (Optional - Nodemailer)
# ============================================

# SMTP Server
SMTP_HOST=smtp.gmail.com

# SMTP Port
SMTP_PORT=587

# SMTP Username/Email
SMTP_USER=your-email@gmail.com

# SMTP Password (use Google App Password for Gmail)
SMTP_PASS=your-app-password

# From email address
SMTP_FROM=noreply@creativecoding.com

# ============================================
# UPLOAD CONFIGURATION
# ============================================

# Maximum file size for uploads (in bytes, 5MB = 5242880)
MAX_FILE_SIZE=5242880

# Directory where uploads are stored
UPLOAD_DIR=uploads

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================

# Redis connection URL (for sessions/caching)
REDIS_URL=redis://localhost:6379

# ============================================
# OAUTH CONFIGURATION (Optional)
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-render-url/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=https://your-render-url/auth/github/callback

# ============================================
# APPLICATION SETTINGS
# ============================================

# App name
APP_NAME=Creative Coding for Sustainable Development

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_GAMIFICATION=true
ENABLE_NOTIFICATIONS=true

# ============================================
# DATABASE BACKUP (Optional)
# ============================================

# Backup directory
BACKUP_DIR=backups

# Backup frequency (in hours)
BACKUP_INTERVAL=24

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Enable debug logging
DEBUG=creative-coding:*

# Enable mock data
USE_MOCK_DATA=false

# Suppress warnings in development
SUPPRESS_WARNINGS=false
